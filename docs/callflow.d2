# Yammer Dictation Call Flow

direction: down

# Trigger
hotkey: "User holds Ctrl+Super (or presses F6 to toggle)"

# Phase 1: Listen and transcribe, concurrently
phase1: 1. Listen + Transcribe (while speaking) {
  start: Start Recording
  capture: cpal AudioCapture
  chunks: Audio Chunks (50ms)
  level: RMS / VAD (waveform, mute check)
  resample: Resample to 24kHz
  step: "Kyutai step (1920 samples = 80ms)"
  partial: Partial Transcript

  start -> capture
  capture -> chunks
  chunks -> level
  chunks -> resample
  resample -> step
  step -> partial: words as they are recognised
}

# Stop: key released or toggled off
stop: Stop {
  drain: Drain buffered audio
  flush: "Flush ~1s silence\n(model's 0.5s audio delay)"
  transcript: Final Transcript

  drain -> flush
  flush -> transcript
}

# Phase 2: LLM Correction (optional)
phase2: 2. LLM Correction (optional) {
  prompt: Build Correction Prompt
  llm: TinyLlama Inference (CPU)
  guard: "Keep raw text if output is empty\nor rewrites the transcript"
  corrected: Corrected Text

  prompt -> llm
  llm -> guard
  guard -> corrected
}

# Phase 3: Output
phase3: 3. Text Output {
  focus: Refocus target window
  method: Check Output Method
  type: xdotool type
  clipboard: "xclip + Shift+Insert\n(uinput, xdotool fallback)"
  done: Text in Target App

  focus -> method
  method -> type: type method
  method -> clipboard: clipboard method
  type -> done
  clipboard -> done
}

# Main flow between phases
hotkey -> phase1.start: trigger
phase1 -> stop: release / toggle
stop.transcript -> phase2.prompt: raw text
phase2.corrected -> phase3.focus: final text

# UI Updates (parallel)
ui: GUI Updates {
  waveform: Waveform Display
  status: Status Indicator
  text: Transcript Display
}

phase1.level -> ui.waveform: audio levels
phase1 -> ui.status: Listening
phase2 -> ui.status: Correcting
phase3 -> ui.status: Done
phase1.partial -> ui.text: live text
phase2.corrected -> ui.text: update text
