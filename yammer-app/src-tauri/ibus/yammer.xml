<?xml version="1.0" encoding="utf-8"?>
<!--
  IBus component descriptor for Yammer's dictation input method. Installed to
  /usr/share/ibus/component/yammer.xml by the .deb package (see
  tauri.conf.json's bundle.linux.deb.files). This is what makes "Yammer
  Dictation" selectable under Settings -> Keyboard -> Input Sources — see
  docs/IBUS_SETUP.md for the one-time setup step.

  <exec> is only used by ibus-daemon if it needs to start the engine itself
  (first selection, or after a logout); the already-running yammer-app
  singleton (started via the hotkey or a normal launch) registers this same
  engine name itself and ibus-daemon reuses that connection instead of
  spawning a second process. See plans/002-ibus-input-engine.md.
-->
<component>
    <name>org.freedesktop.IBus.Yammer</name>
    <description>Yammer dictation input method</description>
    <exec>/usr/bin/yammer-app --ibus-engine</exec>
    <version>0.5.0</version>
    <author>Andy</author>
    <license>MIT</license>
    <homepage>https://github.com/andy/yammer</homepage>
    <textdomain>yammer</textdomain>
    <engines>
        <engine>
            <name>yammer</name>
            <longname>Yammer Dictation</longname>
            <description>Passes typing through unchanged; commits dictated text on toggle</description>
            <language>en</language>
            <license>MIT</license>
            <author>Andy</author>
            <layout>us</layout>
            <rank>0</rank>
        </engine>
    </engines>
</component>
